{{ ansible_managed | comment }}
[Unit]
Description=Trade-Ops CPU tuning (offline SMT siblings, performance governor)
# Run after the CPUs and cpufreq are up. RemainAfterExit keeps the unit "active"
# so its state is visible in systemctl and it is easy to disable to revert.
After=sysinit.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/trade-ops-cpu-tuning.sh

[Install]
WantedBy=multi-user.target
