{{ ansible_managed | comment }}
[Unit]
Description=C++ trading engine (3-hop lock-free pipeline) with tick-to-trade metrics
After=mock-exchange.service trade-ops-cpu.service
Requires=mock-exchange.service

[Service]
Type=simple
User={{ trading_app_user }}
ExecStart={{ trading_app_dir }}/bin/trading_engine \
  --dispatch={{ trading_dispatch }} --alloc={{ trading_alloc }} --huge={{ trading_huge }} \
  --pin=on --rt=on --rate={{ trading_rate }} \
  --md-cpu={{ trading_md_cpu }} --strat-cpu={{ trading_strategy_cpu }} --gw-cpu={{ trading_gateway_cpu }}
Restart=on-failure
RestartSec=2
# Allow housekeeping cores (for logger/metrics/main) AND the isolated cores the
# hot threads pin themselves to. isolcpus keeps the unpinned threads on 0-7 while
# md/strategy/gateway pin to 8/10/12. (Overrides the global CPUAffinity=0-7.)
CPUAffinity={{ trading_housekeeping_cpus }} {{ trading_md_cpu }} {{ trading_strategy_cpu }} {{ trading_gateway_cpu }}
LimitRTPRIO=99
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK

[Install]
WantedBy=multi-user.target
